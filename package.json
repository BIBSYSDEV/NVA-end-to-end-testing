{
  "name": "mva-e2e",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "private": true,
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "create:cucumber:report": "node scripts/cucumber_report.mjs",
    "apply:patches": "patch-package",
    "setup": "npm run apply:patches && cypress install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint:cfn": "cfn-lint template/e2e_pipeline_template.yml",
    "lint:shell": "shellcheck run-tests.sh",
    "check": "npm run typecheck && npm run lint:cfn && npm run lint:shell"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": true,
    "step_definitions": "cypress/e2e/",
    "html": {
      "enabled": true,
      "output": "TestReport/cucumber_report.html"
    },
    "messages": {
      "enabled": true
    }
  },
  "devDependencies": {
    "@cucumber/html-formatter": "^24.1.0",
    "@cucumber/message-streams": "^5.0.1",
    "@types/express": "^5.0.6",
    "aws-cdk": "^2.1133.0",
    "aws-cdk-lib": "^2.262.1",
    "constructs": "^10.7.1",
    "cypress": "^15.19.0",
    "esbuild": "0.28.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-gherkin": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1096.0",
    "@aws-sdk/client-secrets-manager": "^3.1096.0",
    "@badeball/cypress-cucumber-preprocessor": "^26.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "cypress-localstorage-commands": "^2.3.0",
    "uuid": "^14.0.1"
  }
}
